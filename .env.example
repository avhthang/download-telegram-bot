TELEGRAM_BOT_TOKEN=put-your-telegram-bot-token-here

# Optional: where temporary downloads are stored.
DOWNLOAD_DIR=downloads

# Optional: refuse files larger than this after download.
# Telegram's hosted Bot API accepts uploads up to 50 MB. Use 1900 only after
# configuring a Local Bot API Server below.
MAX_FILE_SIZE_MB=49

# Video layout. "16:9" preserves the source without stretching/cropping and
# adds black bars when needed. Set "source" to leave the original aspect ratio.
VIDEO_ASPECT_MODE=16:9

# Delete the user's original link message after this many seconds (86400 = 1 day).
# Set 0 to disable. The bot needs the "Delete messages" admin permission in groups.
DELETE_ORIGINAL_AFTER_SECONDS=86400

# Optional: private storage channel. The bot uploads a video here once, then
# copies it into requesting groups. Supports a numeric private-channel ID or @username.
# STORAGE_CHAT_ID=-1001234567890
# STORAGE_CACHE_DB=storage-cache.sqlite3

# Optional: Local Bot API Server endpoints. Required for uploads above 50 MB.
# TELEGRAM_API_BASE_URL=http://127.0.0.1:8081/bot
# TELEGRAM_API_BASE_FILE_URL=http://127.0.0.1:8081/file/bot

# Optional: yt-dlp browser cookies, useful for sites that need a logged-in session.
# Examples: chrome, edge, firefox
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Optional: raw yt-dlp cookies.txt path.
# YTDLP_COOKIEFILE=/absolute/path/to/cookies.txt

# Optional: comma-separated chat ids. Leave empty to allow every chat/group.
# ALLOWED_CHAT_IDS=-1001234567890,-1009876543210

# Optional: max simultaneous downloads.
MAX_CONCURRENT_DOWNLOADS=2
